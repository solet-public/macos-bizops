{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "node ${PLUGIN_ROOT}/hooks/step_zero_reminder.js",
            "timeout": 5,
            "statusMessage": "Loading project-orientation reminder"
          },
          {
            "type": "command",
            "command": "python3 ${PLUGIN_ROOT}/hooks/session_start_context.py",
            "timeout": 8,
            "statusMessage": "Reading register and peer inbox context"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${PLUGIN_ROOT}/hooks/context_status_reporter.py",
            "timeout": 30,
            "async": true,
            "statusMessage": "Reporting fresh Codex context status"
          },
          {
            "type": "command",
            "command": "python3 ${PLUGIN_ROOT}/hooks/inbox_consumer.py",
            "timeout": 8,
            "statusMessage": "Checking peer inbox before ending turn"
          }
        ]
      }
    ]
  }
}
