{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node ${PLUGIN_ROOT}/hooks/step_zero_reminder.js",
            "timeout": 5,
            "statusMessage": "Loading project-orientation reminder"
          },
          {
            "type": "command",
            "command": "python3 ${PLUGIN_ROOT}/hooks/session_start_context.py",
            "timeout": 30,
            "statusMessage": "Reading register and peer inbox context"
          }
        ]
      },
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${PLUGIN_ROOT}/hooks/recovery_codex.py",
            "timeout": 15,
            "statusMessage": "Checking the working-tree recovery store"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${PLUGIN_ROOT}/hooks/recovery_codex.py",
            "timeout": 15,
            "statusMessage": "Saving working-tree state before a discarding command"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Bash|apply_patch)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${PLUGIN_ROOT}/hooks/recovery_codex.py",
            "timeout": 15,
            "statusMessage": "Recording this session's edits"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${PLUGIN_ROOT}/hooks/context_status_reporter.py",
            "timeout": 30,
            "async": true,
            "statusMessage": "Reporting fresh Codex context status"
          },
          {
            "type": "command",
            "command": "python3 ${PLUGIN_ROOT}/hooks/inbox_consumer.py",
            "timeout": 8,
            "statusMessage": "Checking peer inbox before ending turn"
          },
          {
            "type": "command",
            "command": "python3 ${PLUGIN_ROOT}/hooks/recovery_codex.py",
            "timeout": 120,
            "async": true,
            "statusMessage": "Saving this turn's working tree"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${PLUGIN_ROOT}/hooks/recovery_codex.py",
            "timeout": 3,
            "statusMessage": "Saving the working tree at session end"
          }
        ]
      }
    ]
  }
}
