            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/optional_hook_runner.py",
              "${CLAUDE_PLUGIN_ROOT}/hooks/capture_session_mapping.py",
              "SessionStart"
            ]
          }
        ]
      },
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/optional_hook_runner.py",
              "${CLAUDE_PLUGIN_ROOT}/hooks/recovery_claude.py",
              "SessionStart"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/optional_hook_runner.py",
              "${CLAUDE_PLUGIN_ROOT}/hooks/recovery_claude.py",
              "SessionEnd"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
