        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/optional_hook_runner.py",
              "${CLAUDE_PLUGIN_ROOT}/hooks/wake_waiter.py",
