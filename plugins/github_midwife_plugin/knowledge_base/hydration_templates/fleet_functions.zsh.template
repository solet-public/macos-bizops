# {{HOMUNCULUS_NAME}}-fleet.zsh — OPTIONAL multi-role session functions.
# Sourced by <clone>/client/{{HOMUNCULUS_NAME}}.zsh ONLY if the operator
# accepted the Step 4a fleet-coordination offer in the hydration runbook.
# Lives in the clone, same as the single-session launcher, so it arrives
# via `git pull`, never another ~/.zshrc replacement.
#
# This is a DIFFERENT trust level than claude-{{HOMUNCULUS_NAME}} (the
# Step 2 single-session launcher). That launcher NEVER passes
# --dangerously-skip-permissions (a fixed invariant) --
# it is the safe default for one operator running one session.
# The functions below are for an operator who has explicitly chosen to run
# SEVERAL concurrent named sessions against {{HOMUNCULUS_NAME}} (a
# coordinator-style fleet) and has been walked through what
# --dangerously-skip-permissions and --remote-control actually do. Do not
# render this file, and do not add its `source` line to
# {{HOMUNCULUS_NAME}}.zsh, without that conversation having happened.

# One shared launcher, parameterized by role. Differences from the Step 2
# single-session launcher:
#   --remote-control "$role"   makes this session addressable by Claude
#                               Code's remote-control feature from another
#                               session (what lets a coordinator session
#                               drive/monitor worker sessions). Claude Code
#                               feature, no MCP involved.
#   --dangerously-skip-permissions
#                               opt-in, separately gated below. Skips the
#                               tool-approval prompt on every action. This
#                               is what makes multiple concurrently-running
#                               sessions practical without an operator
#                               babysitting each one's confirmations, but it
#                               removes the per-action safety boundary. Set
#                               {{HOMUNCULUS_NAME}}_FLEET_SKIP_PERMISSIONS=1
#                               in the environment (or edit the line below)
#                               only after you understand that tradeoff.
#
# Peer messaging and role binding need NO flag here: each session's
# SessionStart hook invokes the rename skill, which arms the
# `{{HOMUNCULUS_NAME}} watch` registered-presence watcher (register + claim
# + receive, zero MCP). If — and only if — the operator explicitly wants the
# optional MCP development-channel wake instead and policy permits MCP, set
# {{HOMUNCULUS_NAME}}_FLEET_MCP_CHANNELS=1 to add
# --dangerously-load-development-channels server:{{HOMUNCULUS_NAME}}.
# Default is OFF; do not suggest it unprompted.
_claude_for_{{HOMUNCULUS_NAME}}() {
  local role="$1"
  local model="$2"    # optional CLI model alias; empty = settings.json default
  local effort="$3"   # optional effort level; empty = settings.json default

  typeset -a extra_flags
  [[ -n "$model" ]]  && extra_flags+=(--model "$model")
  [[ -n "$effort" ]] && extra_flags+=(--effort "$effort")
  [[ "${{{HOMUNCULUS_NAME}}_FLEET_SKIP_PERMISSIONS:-0}" == "1" ]] && extra_flags+=(--dangerously-skip-permissions)
  [[ "${{{HOMUNCULUS_NAME}}_FLEET_MCP_CHANNELS:-0}" == "1" ]] && extra_flags+=(--dangerously-load-development-channels server:{{HOMUNCULUS_NAME}})

  HOMUNCULUS_AGENT_SESSION_LABEL="$role" \
  HOMUNCULUS_AGENT_SESSION_ID="ases-$(date +%s)-$$-${RANDOM}" \
  exec claude \
      --name "$role" \
      --remote-control "$role" \
      "${extra_flags[@]}"
}

# One function per role the operator chose in Step 4a. This is the ONE
# canonical example (a single "Coordinator" role) -- duplicate this pattern
# per role, substituting the function name and the role label. Role names
# are the operator's choice; do not invent additional ones unasked.
#
# claude-{{HOMUNCULUS_NAME}}-coordinator() { _claude_for_{{HOMUNCULUS_NAME}} Coordinator }
#
