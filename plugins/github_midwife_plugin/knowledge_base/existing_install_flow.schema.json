{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Existing-install flow contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["flow_id", "schema_version", "supported_predecessors", "operations"],
  "properties": {
    "flow_id": {"type": "string", "minLength": 1},
    "schema_version": {"const": 1},
    "supported_predecessors": {"type": "array", "minItems": 1},
    "operations": {"type": "array", "maxItems": 0}
  }
}
